{
  "name": "ecosolare-os",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "configura": "tsx scripts/configura.ts",
    "amministratore": "tsx --env-file-if-exists=.env.local scripts/crea-amministratore.ts",
    "baseline": "tsx scripts/calcola-baseline-kpi.ts",
    "baseline:stato": "tsx scripts/calcola-baseline-kpi.ts -- --stato",
    "prova:metriche": "tsx --env-file-if-exists=.env.local scripts/prova-metriche.ts",
    "prova:metriche:pulisci": "tsx --env-file-if-exists=.env.local scripts/pulisci-prova-metriche.ts",
    "outbox": "tsx --env-file-if-exists=.env.local scripts/outbox.ts",
    "backup:documenti": "tsx --env-file-if-exists=.env.local scripts/backup-documenti.ts",
    "backup:verifica": "tsx --env-file-if-exists=.env.local scripts/backup-documenti.ts -- --verifica",
    "drive:autorizza": "tsx --env-file-if-exists=.env.local scripts/autorizza-drive.ts",
    "drive:verifica": "tsx --env-file-if-exists=.env.local scripts/verifica-drive.ts",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env.local src/db/migrate.ts",
    "db:verifica": "tsx --env-file-if-exists=.env.local scripts/verifica-db.ts",
    "db:seed": "tsx --env-file-if-exists=.env.local src/db/seed.ts",
    "demo": "tsx --env-file-if-exists=.env.local scripts/demo.ts",
    "check": "npm run lint && npm run typecheck && npm run test"
  },
  "dependencies": {
    "@sparticuz/chromium": "^133.0.0",
    "drizzle-orm": "^0.45.2",
    "geotiff": "^3.0.5",
    "geotiff-geokeys-to-proj4": "^2024.4.13",
    "next": "16.3.0",
    "pdf-lib": "^1.17.1",
    "playwright-core": "^1.62.0",
    "postgres": "^3.4.7",
    "proj4": "^2.21.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.10",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "playwright": "^1.62.0",
    "tailwindcss": "^4",
    "tsx": "^4.20.6",
    "typescript": "^5",
    "vitest": "^3.2.4"
  }
}
