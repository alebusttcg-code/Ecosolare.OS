# Copiare in .env.local e compilare. Il file .env.local NON va mai versionato.
# In staging e produzione questi valori stanno nel secret manager dell'ambiente.

# --- Database (Supabase, regione UE — D-009) ---
# Usare la stringa del TRANSACTION POOLER (Supavisor, porta 6543), non quella
# della connessione diretta: su Vercel ogni richiesta e' un processo separato e
# le connessioni dirette si esauriscono.
# Supabase → Project Settings → Database → Connection string → Transaction pooler
# Formato: postgresql://postgres.<ref>:<password>@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
#
# ATTENZIONE: in locale deve puntare al progetto Supabase di SVILUPPO, non a
# quello dei clienti. Sono due progetti distinti; istruzioni in
# docs/12-database-di-sviluppo.md
DATABASE_URL=

# Da che parte sta il database qui sopra: `sviluppo` o `produzione`.
# Senza questa riga si guarda l'host, e un host non riconosciuto vale
# produzione: gli script che cancellano si rifiutano di partire.
AMBIENTE_DB=sviluppo

# --- Autenticazione ---
# Il token di sessione e' un valore casuale confrontato con il database, non un
# JWT firmato: non c'e' niente da firmare e quindi nessun segreto di sessione.
#
# Il primo amministratore si crea con:  npm run amministratore
#
# L'accesso è a fattore singolo (email + password): la verifica in due passaggi
# è esclusa per scelta di prodotto (ADR-013, superata).

# --- Intake lead ---
# Segreto condiviso con i form del sito e le landing page, inviato
# nell'intestazione x-intake-token. Generare con: openssl rand -hex 32
# Se vuoto, l'endpoint /api/intake risponde 503: meglio disattivo che aperto.
INTAKE_TOKEN=

# --- Manutenzione ---
# Protegge /api/manutenzione/*, chiamato dal cron e non da una persona.
# Generare con: openssl rand -hex 32
# Su Vercel va impostato ANCHE come CRON_SECRET, che e' il valore che Vercel
# invia nell'intestazione Authorization quando lancia il cron.
MAINTENANCE_TOKEN=

# --- Archivio documenti (Supabase Storage) ---
# Senza queste variabili i file restano sul disco locale: va bene in sviluppo,
# su Vercel il disco e' effimero e i documenti sparirebbero al deploy dopo.
# Il bucket deve essere PRIVATO: sono documenti di clienti.
SUPABASE_URL=https://<ref>.supabase.co
# Project Settings → API → service_role. Scavalca RLS: mai in NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=documenti

# --- Copia su Google Drive (D-011) ---
# Id della cartella radice (Drive condiviso, oppure «EcoSolare OS» in Il mio Drive).
# Si legge dall'URL: drive.google.com/drive/folders/<questo>
GOOGLE_DRIVE_ID=
# --- Opzione A: Drive condiviso Workspace ---
# Service account membro del Drive come Gestore dei contenuti.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_KEY=
# --- Opzione B: stessa cartella di Il mio Drive (Gmail) ---
# OAuth dell'utente proprietario. Crea un OAuth client «Desktop» in Cloud Console,
# poi: npm run drive:autorizza
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
# --- Opzione C: Workspace + impersonazione (alternativa a B) ---
# GOOGLE_DRIVE_DELEGATED_USER=tu@tuodominio.it

# --- Google Maps / Solar (D-016, sezione Sviluppo) ---
# Abilitare sul progetto GCP: Geocoding API, Solar API, Maps JavaScript API,
# Maps Static API, Map Tiles API (vista 3D), Places API (New) per autocomplete
# indirizzo. Restringere la key per IP/server (e HTTP referrer se usi anche
# Maps JS in browser). Senza, /sviluppo mostra «Solar non configurato».
GOOGLE_MAPS_API_KEY=

# --- Telegram follow-up (D-015) ---
# Se vuoti, i reminder restano disattivi. Creare un bot con @BotFather.
TELEGRAM_BOT_TOKEN=
# Segreto impostato su setWebhook (header X-Telegram-Bot-Api-Secret-Token).
# Generare con: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=
# Username del bot senza @ (per le istruzioni in app).
TELEGRAM_BOT_USERNAME=
# URL pubblico dell'app (link nelle notifiche). Es. https://….vercel.app
APP_BASE_URL=

